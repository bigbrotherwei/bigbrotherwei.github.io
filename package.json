{
  "name": "bigbrotherwei.github.io",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:visual-background": "node scripts/verify-visual-background.mjs",
    "verify:quotes": "node scripts/verify-quotes.mjs",
    "verify:tools": "node --experimental-strip-types --test tests/tools/*.test.ts && node scripts/verify-tools.mjs",
    "verify": "npm run verify:assets && npm run verify:quotes && npm run verify:visual-background && npm run verify:content && npm run verify:tools",
    "build": "npm run verify && ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.1"
  }
}
