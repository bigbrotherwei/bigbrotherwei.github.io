{
  "name": "bigbrotherwei.github.io",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:visual-background": "node scripts/verify-visual-background.mjs",
    "verify:quotes": "node scripts/verify-quotes.mjs",
    "verify:discovery": "node --experimental-strip-types --test tests/content/*.test.ts",
    "verify:tools": "node --experimental-strip-types --test tests/tools/*.test.ts && node --experimental-strip-types scripts/verify-tools.mjs",
    "verify:seo": "node --experimental-strip-types --test tests/seo/*.test.ts && node scripts/verify-seo-source.mjs",
    "verify:search": "node --experimental-strip-types --test tests/search/*.test.ts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify": "npm run verify:assets && npm run verify:quotes && npm run verify:visual-background && npm run verify:content && npm run verify:discovery && npm run verify:tools && npm run verify:seo && npm run verify:search",
    "build:astro": "npm run verify && ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "index:search": "pagefind --site dist",
    "build": "npm run build:astro && npm run index:search && npm run verify:dist",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2",
    "lucide-astro": "^0.556.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "pagefind": "^1.5.2"
  }
}
