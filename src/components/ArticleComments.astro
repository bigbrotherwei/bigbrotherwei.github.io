---
import { MessageCircle } from 'lucide-astro';
import { giscusAttributes, readGiscusConfig } from '../lib/comments';

const config = readGiscusConfig(import.meta.env);
const attributes = config ? giscusAttributes(config) : {};
---

<section class="article-comments" aria-labelledby="article-comments-title" data-article-comments data-pagefind-ignore {...attributes}>
  <div class="section-heading section-heading--compact">
    <p class="eyebrow">Discussion</p>
    <h2 id="article-comments-title">评论</h2>
  </div>
  {config && <p class="article-comments__notice">加载评论后将连接 GitHub 服务。</p>}
  <p class="article-comments__notice"><a href="/privacy/">隐私说明</a></p>
  <div class="article-comments__actions">
    {config && <button type="button" class="article-comments__load" data-comment-load><MessageCircle aria-hidden="true" size={18} />加载评论</button>}
    <p class="article-comments__status" data-comment-status aria-live="polite">{config ? '' : '评论未开放'}</p>
    <a
      href="https://github.com/bigbrotherwei/bigbrotherwei.github.io/discussions"
      target="_blank"
      rel="noopener noreferrer"
      data-comment-fallback
      hidden
    >前往 GitHub Discussions</a>
  </div>
  <div class="article-comments__embed" data-comment-embed></div>
</section>

<style>
  .article-comments__notice a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>

<script>
  import { mountArticleComments } from '../scripts/article-comments';

  mountArticleComments(document);
</script>
