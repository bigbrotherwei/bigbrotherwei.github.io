---
import { Search } from 'lucide-astro';
import { BookOpenText, BriefcaseBusiness, House, LibraryBig, Monitor, Moon, Sun, UserRound, Wrench } from 'lucide-astro';

const links = [
  { href: '/', label: '首页', icon: House },
  { href: '/posts', label: '文章', icon: BookOpenText },
  { href: '/topics', label: '专题', icon: LibraryBig },
  { href: '/tools', label: '实用工具', icon: Wrench },
  { href: '/projects', label: '项目', icon: BriefcaseBusiness },
  { href: '/about', label: '关于', icon: UserRound },
];
---

<nav class="site-nav" aria-label="主导航">
  <a class="site-nav__brand" href="/">bigbrotherwei</a>
  <div class="site-nav__links">
    {links.map((link) => <a class="site-nav__icon-link" href={link.href} aria-label={link.label} data-tooltip={link.label} aria-current={Astro.url.pathname === link.href || Astro.url.pathname.startsWith(`${link.href}/`) && link.href !== '/' ? 'page' : undefined}><link.icon aria-hidden="true" size={19} strokeWidth={2.2} /></a>)}
    <a class="site-nav__icon-link" href="/search/" aria-label="搜索" data-tooltip="搜索">
      <Search aria-hidden="true" size={19} strokeWidth={2.2} />
    </a>
    <div class="site-nav__theme">
      <button class="site-nav__icon-link site-nav__theme-toggle" type="button" data-theme-toggle aria-label="选择主题" aria-haspopup="menu" aria-expanded="false" aria-controls="site-theme-menu" data-tooltip="选择主题">
        <Sun aria-hidden="true" size={19} strokeWidth={2.2} />
      </button>
      <div class="site-nav__theme-menu" id="site-theme-menu" data-theme-menu role="menu" aria-label="主题" hidden>
        <button type="button" role="menuitemradio" data-theme-choice="system" aria-checked="true"><Monitor aria-hidden="true" size={17} />跟随系统</button>
        <button type="button" role="menuitemradio" data-theme-choice="light" aria-checked="false"><Sun aria-hidden="true" size={17} />浅色</button>
        <button type="button" role="menuitemradio" data-theme-choice="dark" aria-checked="false"><Moon aria-hidden="true" size={17} />深色</button>
      </div>
    </div>
  </div>
</nav>
