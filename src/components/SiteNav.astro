---
import { Search } from 'lucide-astro';

const links = [
  { href: '/', label: '首页' },
  { href: '/posts', label: '文章' },
  { href: '/topics', label: '专题' },
  { href: '/tools', label: '实用工具' },
  { href: '/projects', label: '项目' },
  { href: '/about', label: '关于' },
];
---

<nav class="site-nav" aria-label="主导航">
  <a class="site-nav__brand" href="/">bigbrotherwei</a>
  <div class="site-nav__links">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="site-nav__icon-link" href="/search/" aria-label="搜索" title="搜索">
      <Search aria-hidden="true" size={19} strokeWidth={2.2} />
    </a>
  </div>
</nav>
