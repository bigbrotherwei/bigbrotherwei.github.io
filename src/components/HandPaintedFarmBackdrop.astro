---
import type { PageBackground } from '../data/backgrounds';

interface Props {
  background: PageBackground;
  animateFarmNight?: boolean;
}

const { background, animateFarmNight = false } = Astro.props;
const backdropStyle = [
  `--background-image: url("${background.desktop}")`,
  `--background-image-mobile: url("${background.mobile}")`,
  `--background-position: ${background.position ?? 'center'}`,
  `--background-position-mobile: ${background.mobilePosition ?? 'center'}`,
].join('; ');
---

<div class="hand-painted-farm-backdrop" style={backdropStyle} aria-hidden="true">
  {animateFarmNight && <div class="farm-night">
    <img class="farm-night__moon" src="/images/farm-painted-moon.webp" width="160" height="107" alt="" decoding="async" />
    <img class="farm-night__couple" src="/images/farm-moonwatchers.webp" width="440" height="367" alt="" decoding="async" />
    <div class="farm-night__garden">
      {[1, 2, 3].map((index) => <div class={`farm-night__fairy farm-night__fairy--${index}`}>
        <img src="/images/farm-garden-sprite.webp" width="320" height="273" alt="" decoding="async" />
        <span class="farm-night__droplet"></span>
        <span class="farm-night__droplet"></span>
      </div>)}
    </div>
  </div>}
  <div class="ambient-motion" aria-hidden="true">
    <div class="ambient-motion__meteors">
      <span class="ambient-motion__meteor"></span>
      <span class="ambient-motion__meteor"></span>
    </div>
    <div class="ambient-motion__petals">
      <span class="ambient-motion__petal"></span>
      <span class="ambient-motion__petal"></span>
      <span class="ambient-motion__petal"></span>
      <span class="ambient-motion__petal"></span>
      <span class="ambient-motion__petal"></span>
      <span class="ambient-motion__petal"></span>
    </div>
  </div>
</div>
