---
import type { PageBackground } from '../data/backgrounds';

interface Props {
  background: PageBackground;
}

const { background } = Astro.props;
const backdropStyle = [
  `--background-image: url("${background.desktop}")`,
  `--background-image-mobile: url("${background.mobile}")`,
  `--background-position: ${background.position ?? 'center'}`,
  `--background-position-mobile: ${background.mobilePosition ?? 'center'}`,
].join('; ');
---

<div class="hand-painted-farm-backdrop" style={backdropStyle} aria-hidden="true">
  <div class="ambient-motion" aria-hidden="true">
    <div class="ambient-motion__meteors">
      <span class="ambient-motion__meteor"></span>
      <span class="ambient-motion__meteor"></span>
    </div>
    <div class="ambient-motion__petals">
      <span class="ambient-motion__petal"></span>
      <span class="ambient-motion__petal"></span>
      <span class="ambient-motion__petal"></span>
      <span class="ambient-motion__petal"></span>
      <span class="ambient-motion__petal"></span>
      <span class="ambient-motion__petal"></span>
    </div>
  </div>
</div>
