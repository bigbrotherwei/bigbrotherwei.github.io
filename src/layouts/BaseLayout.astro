---
import PixelFarmBackdrop from '../components/PixelFarmBackdrop.astro';
import SiteNav from '../components/SiteNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = 'bigbrotherwei 的个人博客，记录技术、项目、工具和思考。',
  bodyClass = '',
} = Astro.props;

const siteTitle = title === 'bigbrotherwei' ? title : `${title} | bigbrotherwei`;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{siteTitle}</title>
  </head>
  <body class={bodyClass}>
    <PixelFarmBackdrop />
    <SiteNav />
    <slot />
  </body>
</html>
