---
import HandPaintedFarmBackdrop from '../components/HandPaintedFarmBackdrop.astro';
import SiteNav from '../components/SiteNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = 'bigbrotherwei 的个人博客，记录技术、项目、工具和思考。',
  bodyClass = '',
} = Astro.props;

const siteTitle = title === 'bigbrotherwei' ? title : `${title} | bigbrotherwei`;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href="/images/hand-painted-farm-dusk.webp" media="(min-width: 641px)" fetchpriority="high" />
    <link rel="preload" as="image" href="/images/hand-painted-farm-dusk-mobile.webp" media="(max-width: 640px)" fetchpriority="high" />
    <title>{siteTitle}</title>
  </head>
  <body class={bodyClass}>
    <HandPaintedFarmBackdrop />
    <SiteNav />
    <slot />
  </body>
</html>
