---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="关于"
  description="关于 bigbrotherwei 的个人说明、技术兴趣和当前关注方向。"
  backgroundKey="about"
>
  <main class="page-shell">
    <PageHero
      eyebrow="About"
      title="关于 bigbrotherwei"
      description="这里记录技术实践，也放着我正在维护的博客和工具。"
    />

    <section class="sketch-grid" aria-label="关于内容">
      <article class="sketch-card">
        <p class="eyebrow">Focus</p>
        <h2>当前关注</h2>
        <p>FoundationDB、个人博客工程化、静态站点体验，以及把实践整理成可复用的文章与工具。</p>
      </article>
      <article class="sketch-card">
        <p class="eyebrow">Build</p>
        <h2>博客如何构建</h2>
        <p>站点使用 Astro、TypeScript 和 Markdown，通过功能分支与 Pull Request 维护，合并到 master 后由 GitHub Actions 发布到 GitHub Pages。</p>
      </article>
      <article class="sketch-card">
        <p class="eyebrow">Shipped</p>
        <h2>已经可以使用</h2>
        <p>文章可以按专题、标签和时间查找；工具箱提供纯前端的小工具，内容会持续补充。</p>
      </article>
      <article class="sketch-card">
        <p class="eyebrow">Links</p>
        <h2>公开链接</h2>
        <p class="about-links">
          <a href="https://github.com/bigbrotherwei" target="_blank" rel="noreferrer">GitHub 主页</a>
          <a href="https://github.com/bigbrotherwei/bigbrotherwei.github.io" target="_blank" rel="noreferrer">博客源码</a>
        </p>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
  }

  .about-links a {
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
