---
import { getCollection } from 'astro:content';
import { ArrowRight } from 'lucide-astro';
import PostDate from '../components/PostDate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDailyQuote, quotes } from '../data/quotes';
import { tools } from '../data/tools';
import { buildWebsiteJsonLd } from '../lib/seo';

const publishedPosts = (await getCollection('posts')).filter((post) => !post.data.draft);
const latestPosts = [...publishedPosts]
  .sort((left, right) => right.data.pubDate.getTime() - left.data.pubDate.getTime())
  .slice(0, 3);
const topics = await getCollection('topics');
const featuredTopic = topics
  .map((topic) => ({ topic, posts: publishedPosts.filter((post) => post.data.topic === topic.id) }))
  .filter(({ posts }) => posts.length > 0)
  .sort((left, right) => right.posts.length - left.posts.length)[0];
const firstTopicPost = featuredTopic?.posts.sort((left, right) => left.data.order - right.data.order)[0];
const featuredTools = ['images-pdf', 'markdown', 'json', 'uuid']
  .flatMap((slug) => tools.filter((tool) => tool.slug === slug));
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'UTC',
}).format(date);
const dailyQuote = getDailyQuote();
const quoteAuthor = dailyQuote.source
  ? `-- ${dailyQuote.author}《${dailyQuote.source}》`
  : `-- ${dailyQuote.author}`;
const structuredData = buildWebsiteJsonLd({ site: Astro.site! });
---

<BaseLayout title="bigbrotherwei" bodyClass="home" backgroundKey="home" {structuredData}>
  <main>
    <section class="home-hero">
      <section class="hero-content" aria-labelledby="site-title">
        <p class="eyebrow">Personal Blog</p>
        <h1 id="site-title">bigbrotherwei</h1>
        <p class="quote" data-quote-text>{dailyQuote.text}</p>
        <p class="quote-author" data-quote-author>{quoteAuthor}</p>
      </section>
    </section>

    <div class="home-discovery page-shell">
      <section class="home-latest" aria-labelledby="home-latest-title">
        <div class="home-section-heading">
          <div><p class="eyebrow">Latest Posts</p><h2 id="home-latest-title">最近发布</h2></div>
          <a href="/posts/">全部文章 <ArrowRight aria-hidden="true" size={17} /></a>
        </div>
        {latestPosts.length > 0 ? <div class="home-post-list">
          {latestPosts.map((post) => <a class="home-post" href={`/posts/${post.id}/`}>
            <PostDate date={post.data.pubDate} text={formatDate(post.data.pubDate)} />
            <span class="home-post__text"><strong>{post.data.title}</strong><span>{post.data.description}</span></span>
            <ArrowRight aria-hidden="true" size={18} />
          </a>)}
        </div> : <p class="home-empty">文章正在整理中。</p>}
      </section>

      {featuredTopic && <section class="home-topic" aria-labelledby="home-topic-title">
        <div class="home-section-heading">
          <div><p class="eyebrow">Reading Path</p><h2 id="home-topic-title">从专题开始</h2></div>
          <a href="/topics/">全部专题 <ArrowRight aria-hidden="true" size={17} /></a>
        </div>
        <div class="home-topic__content">
          <div><span>{featuredTopic.posts.length} 篇文章</span><h3><a href={`/topics/${featuredTopic.topic.id}/`}>{featuredTopic.topic.data.title}</a></h3><p>{featuredTopic.topic.data.description}</p></div>
          {firstTopicPost && <a class="home-topic__start" href={`/posts/${firstTopicPost.id}/`}>从第一篇开始 <ArrowRight aria-hidden="true" size={17} /></a>}
        </div>
      </section>}

      <section class="home-tools" aria-labelledby="home-tools-title">
        <div class="home-section-heading">
          <div><p class="eyebrow">Useful Tools</p><h2 id="home-tools-title">常用工具</h2></div>
          <a href="/tools/">全部工具 <ArrowRight aria-hidden="true" size={17} /></a>
        </div>
        <div class="home-tools__grid">
          {featuredTools.map((tool) => <a href={tool.href}><strong>{tool.title}</strong><span>{tool.description}</span><ArrowRight aria-hidden="true" size={17} /></a>)}
        </div>
      </section>
    </div>
  </main>

  <script is:inline type="application/json" id="daily-quotes" set:html={JSON.stringify(quotes)}></script>

  <script is:inline>
    const quoteDataElement = document.getElementById('daily-quotes');
    const quotes = JSON.parse(quoteDataElement?.textContent || '[]');
    const quoteText = document.querySelector('[data-quote-text]');
    const quoteAuthor = document.querySelector('[data-quote-author]');
    const dayStart = new Date();
    dayStart.setHours(0, 0, 0, 0);
    const dayIndex = quotes.length > 0
      ? Math.abs(Math.floor(dayStart.getTime() / 86400000)) % quotes.length
      : 0;
    const quote = quotes[dayIndex];

    if (quote && quoteText && quoteAuthor) {
      quoteText.textContent = quote.text;
      quoteAuthor.textContent = quote.source
        ? `-- ${quote.author}《${quote.source}》`
        : `-- ${quote.author}`;
    }
  </script>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    display: grid;
    min-height: clamp(32rem, 82svh, 56rem);
    overflow: hidden;
    background: transparent;
  }

  .home-hero::before {
    position: absolute;
    inset: 0;
    content: "";
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(5, 16, 28, 0.22), rgba(7, 18, 29, 0.08) 38%, rgba(5, 15, 23, 0.5));
  }

  .hero-content {
    position: relative;
    z-index: 1;
    align-self: center;
    justify-self: center;
    width: min(90vw, 760px);
    padding: 7rem 1.5rem 4rem;
    text-align: center;
    text-shadow: 0 2px 18px rgba(52, 44, 26, 0.54);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-warm);
    font-size: 0.9rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #fffaf1;
    font-size: clamp(3rem, 12vw, 7rem);
    line-height: 1;
    letter-spacing: 0;
    text-shadow:
      0 0.2rem 0 #473226,
      0 0.35rem 0.8rem rgba(52, 44, 26, 0.54),
      0 0 2.8rem rgba(255, 210, 105, 0.24);
  }

  .quote {
    margin: 2rem auto 0;
    color: #fffaf1;
    font-size: clamp(1.15rem, 2.4vw, 1.65rem);
    line-height: 1.8;
  }

  .quote-author {
    margin: 0.75rem 0 0;
    color: rgba(255, 250, 241, 0.78);
    font-size: 1rem;
  }

  .home-discovery { display: grid; gap: 4rem; padding-top: 2.5rem; }
  .home-section-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.1rem; }
  .home-section-heading h2 { margin: 0.3rem 0 0; color: var(--color-scene-text); font-size: 1.75rem; }
  .home-section-heading .eyebrow { color: var(--color-scene-link); }
  .home-section-heading > a, .home-topic__start { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--color-scene-link); font-weight: 700; white-space: nowrap; }
  .home-post-list { border-top: 1px solid rgba(255, 250, 241, 0.26); }
  .home-post { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr) auto; align-items: center; gap: 1.2rem; padding: 1.1rem 0; color: var(--color-scene-text); border-bottom: 1px solid rgba(255, 250, 241, 0.26); }
  .home-post:hover, .home-tools__grid a:hover { color: var(--color-scene-link); }
  .home-post__text { display: grid; gap: 0.3rem; min-width: 0; }
  .home-post__text strong { font-size: 1.12rem; line-height: 1.4; }
  .home-post__text span { color: var(--color-scene-muted); line-height: 1.6; }
  .home-post, .home-tools__grid a { text-shadow: 0 1px 4px rgba(3, 12, 18, 0.65); }
  .home-topic__content { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding: 1.3rem 1.5rem; background: var(--color-panel-glass); border: 1px solid var(--color-glass-border); border-radius: 8px; }
  .home-topic__content span { color: var(--color-accent); font-size: 0.84rem; font-weight: 700; }
  .home-topic__content h3 { margin: 0.35rem 0; color: var(--color-text); font-size: 1.35rem; }
  .home-topic__content p { max-width: 48rem; margin: 0; color: var(--color-muted); line-height: 1.7; }
  .home-topic__start { color: var(--color-accent); }
  .home-tools__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2rem; border-top: 1px solid rgba(255, 250, 241, 0.26); }
  .home-tools__grid a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.3rem 0.6rem; padding: 1rem 0; color: var(--color-scene-text); border-bottom: 1px solid rgba(255, 250, 241, 0.26); }
  .home-tools__grid strong { font-size: 1.02rem; }
  .home-tools__grid span { grid-row: 2; color: var(--color-scene-muted); line-height: 1.5; }
  .home-tools__grid svg { grid-column: 2; grid-row: 1; }
  .home-empty { color: var(--color-scene-muted); }
  @media (max-width: 680px) {
    .home-section-heading { align-items: start; }
    .home-section-heading > a { align-self: end; font-size: 0.88rem; }
    .home-post { grid-template-columns: minmax(0, 1fr) auto; gap: 0.45rem; }
    .home-post :global(.post-date) { grid-column: 1 / -1; }
    .home-topic__content { flex-direction: column; align-items: start; }
    .home-tools__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
