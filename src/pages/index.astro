---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDailyQuote, quotes } from '../data/quotes';

const dailyQuote = getDailyQuote();
const quoteAuthor = dailyQuote.source
  ? `-- ${dailyQuote.author}《${dailyQuote.source}》`
  : `-- ${dailyQuote.author}`;
---

<BaseLayout title="bigbrotherwei" bodyClass="home">
  <main>
    <section class="home-hero pixel-farm-hero">
      <div class="pixel-farm-hero__cabin" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
      <div class="pixel-farm-hero__field" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
      <section class="hero-content" aria-labelledby="site-title">
        <p class="eyebrow">Personal Blog</p>
        <h1 id="site-title">bigbrotherwei</h1>
        <p class="quote" data-quote-text>{dailyQuote.text}</p>
        <p class="quote-author" data-quote-author>{quoteAuthor}</p>
      </section>
    </section>

    <section class="home-sections">
      <div class="page-shell">
        <div class="section-heading">
          <p class="eyebrow">Next Pages</p>
          <h2>把想法慢慢画成地图</h2>
          <p>这里会逐步沉淀文章、专题、实用工具、项目记录和一点个人说明。第二阶段先把入口铺好，让博客像一个可以继续生长的工作台。</p>
        </div>

        <div class="sketch-grid">
          <a class="sketch-card home-card" href="/posts">
            <span>文章</span>
            <h3>技术笔记与思考</h3>
            <p>后续会放 Astro、GitHub Pages、工程实践和日常学习记录。</p>
          </a>
          <a class="sketch-card home-card" href="/topics">
            <span>专题</span>
            <h3>个人博客重构实录</h3>
            <p>把这次从旧静态产物到新博客工程的过程整理成连续专题。</p>
          </a>
          <a class="sketch-card home-card" href="/tools">
            <span>实用工具</span>
            <h3>内置开发者工具箱</h3>
            <p>先搭工具入口，后续逐步实现 JSON、Base64、URL、时间戳等纯前端工具。</p>
          </a>
          <a class="sketch-card home-card" href="/projects">
            <span>项目</span>
            <h3>实验与作品</h3>
            <p>记录正在维护的项目、尝试过的想法，以及能复用的工程经验。</p>
          </a>
          <a class="sketch-card home-card" href="/about">
            <span>关于</span>
            <h3>bigbrotherwei</h3>
            <p>一个更像手账页的个人说明：兴趣、方向、技术栈和联系方式。</p>
          </a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline type="application/json" id="daily-quotes" set:html={JSON.stringify(quotes)}></script>

  <script is:inline>
    const quoteDataElement = document.getElementById('daily-quotes');
    const quotes = JSON.parse(quoteDataElement?.textContent || '[]');
    const quoteText = document.querySelector('[data-quote-text]');
    const quoteAuthor = document.querySelector('[data-quote-author]');
    const dayStart = new Date();
    dayStart.setHours(0, 0, 0, 0);
    const dayIndex = quotes.length > 0
      ? Math.abs(Math.floor(dayStart.getTime() / 86400000)) % quotes.length
      : 0;
    const quote = quotes[dayIndex];

    if (quote && quoteText && quoteAuthor) {
      quoteText.textContent = quote.text;
      quoteAuthor.textContent = quote.source
        ? `-- ${quote.author}《${quote.source}》`
        : `-- ${quote.author}`;
    }
  </script>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    overflow: hidden;
    background-color: transparent;
    background-image:
      linear-gradient(to bottom, rgba(29, 48, 76, 0.08), rgba(56, 96, 58, 0.2) 62%, rgba(49, 87, 45, 0.24)),
      radial-gradient(circle at 52% 18%, rgba(255, 226, 145, 0.2), transparent 18rem);
    background-position: center;
    background-size: cover;
  }

  .home-hero::before {
    position: absolute;
    inset: 0;
    content: "";
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(20, 38, 58, 0.26), transparent 38%),
      linear-gradient(to top, rgba(38, 65, 40, 0.72), transparent 52%);
  }

  .pixel-farm-hero::after {
    position: absolute;
    right: -6rem;
    bottom: -1rem;
    left: -6rem;
    height: min(28vh, 13rem);
    content: "";
    background:
      repeating-linear-gradient(90deg, rgba(255, 224, 137, 0.16) 0 0.75rem, transparent 0.75rem 3.4rem),
      repeating-linear-gradient(0deg, rgba(95, 57, 34, 0.22) 0 0.35rem, transparent 0.35rem 2.2rem),
      linear-gradient(180deg, rgba(92, 141, 65, 0.9), rgba(44, 93, 53, 0.95));
    border-top: 0.22rem solid rgba(255, 224, 137, 0.34);
    image-rendering: pixelated;
    transform: rotate(-0.4deg);
  }

  .pixel-farm-hero__cabin {
    position: absolute;
    right: clamp(1rem, 12vw, 9rem);
    bottom: min(23vh, 10rem);
    width: clamp(8rem, 18vw, 13rem);
    aspect-ratio: 1.26;
    background:
      linear-gradient(90deg, transparent 0 14%, rgba(255, 219, 124, 0.88) 14% 28%, transparent 28% 100%),
      linear-gradient(#8c5d36 0 0);
    border: 0.22rem solid #4d3226;
    box-shadow:
      0.65rem 0.65rem 0 rgba(35, 47, 32, 0.28),
      inset 0 0 0 0.16rem rgba(255, 245, 210, 0.18);
    image-rendering: pixelated;
  }

  .pixel-farm-hero__cabin::before {
    position: absolute;
    right: -0.55rem;
    bottom: 100%;
    left: -0.55rem;
    height: 44%;
    content: "";
    background: #b8613d;
    border: 0.22rem solid #4d3226;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .pixel-farm-hero__cabin span:first-child {
    position: absolute;
    right: 18%;
    bottom: 16%;
    width: 24%;
    height: 42%;
    background: #68442e;
    border: 0.16rem solid #3a251f;
  }

  .pixel-farm-hero__cabin span:last-child {
    position: absolute;
    left: 18%;
    top: 26%;
    width: 22%;
    height: 22%;
    background: #ffe08a;
    border: 0.16rem solid #3a251f;
    box-shadow: 0 0 1.6rem rgba(255, 214, 116, 0.44);
  }

  .pixel-farm-hero__field {
    position: absolute;
    bottom: 2.5rem;
    left: clamp(1rem, 9vw, 7rem);
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.65rem;
    width: clamp(13rem, 28vw, 22rem);
    transform: rotate(1deg);
  }

  .pixel-farm-hero__field span {
    display: block;
    height: clamp(2rem, 5vw, 3.4rem);
    background:
      repeating-linear-gradient(90deg, transparent 0 0.55rem, rgba(70, 128, 63, 0.75) 0.55rem 1rem),
      linear-gradient(#7c4d2f, #5b3828);
    border: 0.16rem solid rgba(61, 39, 31, 0.74);
    image-rendering: pixelated;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    align-self: center;
    justify-self: center;
    width: min(90vw, 760px);
    padding: 7rem 1.5rem 4rem;
    text-align: center;
    text-shadow: 0 2px 18px rgba(52, 44, 26, 0.54);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-warm);
    font-size: 0.9rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #fffaf1;
    font-size: clamp(3rem, 12vw, 7rem);
    line-height: 1;
    letter-spacing: 0;
    text-shadow:
      0 0.2rem 0 #473226,
      0 0.35rem 0.8rem rgba(52, 44, 26, 0.54),
      0 0 2.8rem rgba(255, 210, 105, 0.24);
  }

  .quote {
    margin: 2rem auto 0;
    color: #fffaf1;
    font-size: clamp(1.15rem, 2.4vw, 1.65rem);
    line-height: 1.8;
  }

  .quote-author {
    margin: 0.75rem 0 0;
    color: rgba(255, 250, 241, 0.78);
    font-size: 1rem;
  }

  .home-sections {
    background:
      linear-gradient(to bottom, rgba(17, 35, 51, 0.08), transparent 9rem),
      transparent;
  }

  .section-heading {
    max-width: 740px;
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    margin: 0.35rem 0 0;
    color: #fffaf1;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.12;
    letter-spacing: 0;
    text-shadow: 0 0.25rem 1.2rem rgba(4, 12, 21, 0.34);
  }

  .section-heading p:last-child {
    margin: 1rem 0 0;
    color: rgba(255, 250, 241, 0.76);
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .home-card {
    display: grid;
    min-height: 210px;
    align-content: start;
    gap: 0.8rem;
  }

  .home-card span {
    width: fit-content;
    color: var(--color-coral);
    font-size: 0.84rem;
    font-weight: 800;
  }

  .home-card h3 {
    margin: 0;
    color: var(--color-ink);
    font-size: 1.35rem;
    line-height: 1.35;
  }

  .home-card p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.8;
  }
</style>
