---
import '../styles/global.css';

const heroImage = '/images/hero-city-night.png';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="bigbrotherwei 的个人博客，记录技术、项目、工具和思考。"
    />
    <link rel="preload" as="image" href={heroImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>bigbrotherwei</title>
  </head>
  <body>
    <main class="hero" style={`--hero-image: url("${heroImage}")`}>
      <nav class="nav" aria-label="主导航">
        <a class="brand" href="/">bigbrotherwei</a>
        <div class="nav-links">
          <a href="/posts">文章</a>
          <a href="/topics">专题</a>
          <a href="/tools">实用工具</a>
          <a href="/projects">项目</a>
          <a href="/about">关于</a>
        </div>
      </nav>

      <section class="hero-content" aria-labelledby="site-title">
        <p class="eyebrow">Personal Blog</p>
        <h1 id="site-title">bigbrotherwei</h1>
        <p class="quote">知者不惑，仁者不忧，勇者不惧。</p>
        <p class="quote-author">-- 孔子《论语》</p>
      </section>
    </main>
  </body>
</html>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100vh;
    overflow: hidden;
    background-color: #070b13;
    background-image:
      linear-gradient(rgba(4, 8, 16, 0.34), rgba(4, 8, 16, 0.78)),
      radial-gradient(circle at 50% 38%, rgba(23, 48, 79, 0.18), transparent 32rem),
      var(--hero-image);
    background-position: center, center, center bottom;
    background-size: cover, cover, cover;
  }

  .hero::after {
    position: absolute;
    inset: auto 0 0;
    height: 42vh;
    content: "";
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72), transparent);
    opacity: 0.72;
  }

  .nav {
    position: fixed;
    z-index: 2;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.1rem clamp(1.25rem, 4vw, 4rem);
    color: #fff;
  }

  .brand {
    font-weight: 700;
    letter-spacing: 0;
  }

  .nav-links {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.4rem);
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .nav-links a:hover {
    color: var(--color-accent);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    align-self: center;
    justify-self: center;
    width: min(90vw, 760px);
    padding: 7rem 1.5rem 4rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: 0.9rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 12vw, 7rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .quote {
    margin: 2rem auto 0;
    color: var(--color-text);
    font-size: clamp(1.15rem, 2.4vw, 1.65rem);
    line-height: 1.8;
  }

  .quote-author {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    font-size: 1rem;
  }

  @media (max-width: 720px) {
    .nav {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
    }

    .nav-links {
      flex-wrap: wrap;
      font-size: 0.86rem;
    }
  }
</style>
