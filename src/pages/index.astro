---
import BaseLayout from '../layouts/BaseLayout.astro';

const heroImage = '/images/hero-city-sketch.png';
---

<BaseLayout title="bigbrotherwei" heroImage={heroImage} bodyClass="home">
  <main class="home-hero" style={`--hero-image: url("${heroImage}")`}>
    <section class="hero-content" aria-labelledby="site-title">
      <p class="eyebrow">Personal Blog</p>
      <h1 id="site-title">bigbrotherwei</h1>
      <p class="quote">知者不惑，仁者不忧，勇者不惧。</p>
      <p class="quote-author">-- 孔子《论语》</p>
    </section>
  </main>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    overflow: hidden;
    background-color: var(--color-ink);
    background-image:
      linear-gradient(rgba(11, 31, 48, 0.16), rgba(11, 31, 48, 0.76)),
      radial-gradient(circle at 50% 32%, rgba(240, 185, 109, 0.12), transparent 28rem),
      var(--hero-image);
    background-position: center, center, center bottom;
    background-size: cover, cover, cover;
  }

  .home-hero::before {
    position: absolute;
    inset: 0;
    content: "";
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(8, 22, 35, 0.34), transparent 36%),
      linear-gradient(to top, rgba(8, 22, 35, 0.78), transparent 46%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    align-self: center;
    justify-self: center;
    width: min(90vw, 760px);
    padding: 7rem 1.5rem 4rem;
    text-align: center;
    text-shadow: 0 2px 24px rgba(5, 16, 27, 0.62);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-warm);
    font-size: 0.9rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 12vw, 7rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .quote {
    margin: 2rem auto 0;
    color: #fffaf1;
    font-size: clamp(1.15rem, 2.4vw, 1.65rem);
    line-height: 1.8;
  }

  .quote-author {
    margin: 0.75rem 0 0;
    color: rgba(255, 250, 241, 0.78);
    font-size: 1rem;
  }
</style>
