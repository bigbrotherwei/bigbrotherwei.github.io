---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const topics = (await getCollection('topics')).sort((left, right) => left.data.order - right.data.order);
const posts = (await getCollection('posts')).filter((post) => !post.data.draft);
const postCountByTopic = new Map<string, number>();

for (const post of posts) {
  postCountByTopic.set(post.data.topic, (postCountByTopic.get(post.data.topic) ?? 0) + 1);
}
---

<BaseLayout
  title="专题"
  description="专题用于把多篇文章组织成有顺序的学习路径或项目记录。"
>
  <main class="page-shell">
    <PageHero
      eyebrow="Topics"
      title="专题"
      description="专题不是分类，而是一条被整理过的阅读路径。它把多篇文章串成可以持续更新的小册子。"
    />

    <section class="sketch-grid" aria-label="专题列表">
      {topics.map((topic) => (
        <a class="sketch-card content-card" href={`/topics/${topic.id}/`}>
          <div class="content-card__meta">
            <span>{topic.data.status}</span>
            <span>{postCountByTopic.get(topic.id) ?? 0} 篇文章</span>
          </div>
          <h2>{topic.data.title}</h2>
          <p>{topic.data.description}</p>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
