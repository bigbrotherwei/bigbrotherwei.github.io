---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((left, right) => {
  if (left.data.featured !== right.data.featured) {
    return Number(right.data.featured) - Number(left.data.featured);
  }

  if (left.data.order !== right.data.order) {
    return left.data.order - right.data.order;
  }

  return right.data.startDate.getTime() - left.data.startDate.getTime();
});

const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(date);
---

<BaseLayout
  title="项目"
  description="bigbrotherwei 的项目、实验和长期维护内容。"
  backgroundKey="projects-index"
>
  <main class="page-shell">
    <PageHero
      eyebrow="Projects"
      title="项目"
      description="正在维护的项目、实验和可复用的工程经验。"
    />

    <section class="sketch-grid" aria-label="项目列表">
      {projects.map((project) => (
        <a class="sketch-card content-card" href={`/projects/${project.id}/`}>
          <div class="content-card__meta">
            <span>{project.data.status}</span>
            <time datetime={(project.data.updatedDate ?? project.data.startDate).toISOString()}>
              更新于 {formatDate(project.data.updatedDate ?? project.data.startDate)}
            </time>
          </div>
          <h2>{project.data.title}</h2>
          <p>{project.data.description}</p>
          <div class="tag-list" aria-label={`${project.data.title} 标签`}>
            {project.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
