---
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="文章"
  description="bigbrotherwei 的技术文章、学习记录和阶段性思考。"
>
  <main class="page-shell">
    <PageHero
      eyebrow="Posts"
      title="文章"
      description="这里会放按时间发布的单篇内容。下一阶段会接入 Astro content collections，让 Markdown 文章可以按分类、标签和专题组织。"
    />

    <section class="sketch-grid" aria-label="文章计划">
      <article class="sketch-card">
        <p class="eyebrow">Coming Soon</p>
        <h2>个人博客重构第一篇</h2>
        <p>准备记录从旧 Hexo 静态产物迁移到 Astro 源码工程的过程、取舍和踩坑。</p>
      </article>
      <article class="sketch-card">
        <p class="eyebrow">Draft Queue</p>
        <h2>GitHub Pages 自动发布</h2>
        <p>后续会整理 Pages、Actions、PR 工作流和发布验证方法。</p>
      </article>
    </section>
  </main>
</BaseLayout>
