---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import PostDate from '../../components/PostDate.astro';
import PostsSubnav from '../../components/PostsSubnav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((left, right) => right.data.pubDate.getTime() - left.data.pubDate.getTime());

const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(date);
---

<BaseLayout
  title="文章"
  description="bigbrotherwei 的技术文章、学习记录和阶段性思考。"
  backgroundKey="posts-index"
>
  <main class="page-shell">
    <PageHero
      eyebrow="Posts"
      title="文章"
      description="技术实践与学习记录，按发布时间浏览。"
    />

    <PostsSubnav active="posts" />

    <section class="content-list" aria-label="文章列表">
      {posts.length > 0 ? posts.map((post) => (
        <a class="sketch-card content-card" href={`/posts/${post.id}/`}>
          <div class="content-card__meta">
            <PostDate date={post.data.pubDate} text={formatDate(post.data.pubDate)} />
            <span>{post.data.tags.join(' / ')}</span>
          </div>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
        </a>
      )) : <p class="discovery-empty">还没有发布的文章。</p>}
    </section>
  </main>
</BaseLayout>
