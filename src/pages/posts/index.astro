---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((left, right) => right.data.pubDate.getTime() - left.data.pubDate.getTime());

const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(date);
---

<BaseLayout
  title="文章"
  description="bigbrotherwei 的技术文章、学习记录和阶段性思考。"
>
  <main class="page-shell">
    <PageHero
      eyebrow="Posts"
      title="文章"
      description="文章是按时间发布的单篇内容。它可以独立阅读，也可以通过 frontmatter 归入某个专题。"
    />

    <section class="content-list" aria-label="文章列表">
      {posts.map((post) => (
        <a class="sketch-card content-card" href={`/posts/${post.id}/`}>
          <div class="content-card__meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <span>{post.data.tags.join(' / ')}</span>
          </div>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
