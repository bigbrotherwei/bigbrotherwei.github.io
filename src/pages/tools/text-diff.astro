---
import ToolLayout from '../../components/tools/ToolLayout.astro';
import { tools } from '../../data/tools';

const tool = tools.find(({ slug }) => slug === 'text-diff');
if (!tool) throw new Error('缺少文本差异对比工具注册信息');
---

<ToolLayout title={tool.title} description={tool.description} backgroundKey="tool-text-diff" statusId="text-diff-status">
  <div class="tool-diff-inputs">
    <div class="tool-field">
      <label for="text-diff-old">旧文本</label>
      <textarea id="text-diff-old" spellcheck="false" placeholder="粘贴修改前的文本"></textarea>
    </div>
    <div class="tool-field">
      <label for="text-diff-new">新文本</label>
      <textarea id="text-diff-new" spellcheck="false" placeholder="粘贴修改后的文本"></textarea>
    </div>
  </div>
  <div class="tool-diff-controls">
    <div class="tool-segmented" role="group" aria-label="对比模式">
      <button type="button" data-diff-mode="line" aria-pressed="true">按行</button>
      <button type="button" data-diff-mode="word" aria-pressed="false">按词</button>
    </div>
    <div class="tool-toolbar" aria-label="差异操作">
      <button type="button" id="text-diff-compare">对比</button>
      <button type="button" id="text-diff-swap">交换</button>
      <button type="button" id="text-diff-clear">清空</button>
      <button type="button" id="text-diff-copy" disabled>复制摘要</button>
    </div>
  </div>
  <section class="tool-diff-output" aria-label="差异结果" aria-describedby="text-diff-status">
    <h2>对比结果</h2>
    <div id="text-diff-result" class="tool-diff-result"></div>
  </section>
</ToolLayout>

<script>
  import { compareText, renderDiff, summarizeDiff, swapDiffInputs } from '../../lib/tools/text-diff.ts';
  import type { DiffChunk, DiffMode } from '../../lib/tools/text-diff.ts';
  import { copyText } from '../../lib/tools/browser.ts';

  const oldInput = document.querySelector<HTMLTextAreaElement>('#text-diff-old');
  const newInput = document.querySelector<HTMLTextAreaElement>('#text-diff-new');
  const output = document.querySelector<HTMLElement>('#text-diff-result');
  const status = document.querySelector<HTMLElement>('#text-diff-status');
  const copyButton = document.querySelector<HTMLButtonElement>('#text-diff-copy');
  const compareButton = document.querySelector<HTMLButtonElement>('#text-diff-compare');
  const swapButton = document.querySelector<HTMLButtonElement>('#text-diff-swap');
  const clearButton = document.querySelector<HTMLButtonElement>('#text-diff-clear');
  if (!oldInput || !newInput || !output || !status || !copyButton || !compareButton || !swapButton || !clearButton) {
    throw new Error('文本差异工作台缺少必要控件');
  }

  let mode: DiffMode = 'line';
  let chunks: DiffChunk[] = [];
  let hasResult = false;
  const showStatus = (message: string, state: 'success' | 'error' | 'idle' = 'idle') => {
    status.textContent = message;
    if (state === 'idle') delete status.dataset.state;
    else status.dataset.state = state;
  };
  const invalidate = () => {
    chunks = [];
    hasResult = false;
    output.replaceChildren();
    copyButton.disabled = true;
    showStatus('文本已更改，请重新对比');
  };
  const compare = () => {
    const result = compareText(oldInput.value, newInput.value, mode);
    if (!result.ok) {
      invalidate();
      showStatus(result.error, 'error');
      return;
    }
    chunks = result.value;
    hasResult = true;
    renderDiff(output, chunks);
    copyButton.disabled = !chunks.some(({ kind }) => kind !== 'same');
    showStatus(
      !oldInput.value && !newInput.value ? '两份文本均为空' : copyButton.disabled ? '两份文本相同' : '对比完成',
      'success',
    );
  };

  oldInput.addEventListener('input', invalidate);
  newInput.addEventListener('input', invalidate);
  compareButton.addEventListener('click', compare);
  document.querySelectorAll<HTMLButtonElement>('[data-diff-mode]').forEach((button) => {
    button.addEventListener('click', () => {
      mode = button.dataset.diffMode as DiffMode;
      document.querySelectorAll<HTMLButtonElement>('[data-diff-mode]').forEach((option) => {
        option.setAttribute('aria-pressed', String(option === button));
      });
      if (hasResult) compare();
    });
  });
  swapButton.addEventListener('click', () => {
    const swapped = swapDiffInputs(oldInput.value, newInput.value);
    oldInput.value = swapped.oldText;
    newInput.value = swapped.newText;
    if (hasResult) compare();
    else invalidate();
    oldInput.focus();
  });
  clearButton.addEventListener('click', () => {
    oldInput.value = '';
    newInput.value = '';
    invalidate();
    showStatus('已清空文本');
    oldInput.focus();
  });
  copyButton.addEventListener('click', async () => {
    const result = await copyText(summarizeDiff(chunks));
    showStatus(result.ok ? '已复制差异摘要' : result.error, result.ok ? 'success' : 'error');
  });
</script>
