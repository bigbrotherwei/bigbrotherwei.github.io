---
import ToolLayout from '../../components/tools/ToolLayout.astro';
import { tools } from '../../data/tools';

const tool = tools.find(({ slug }) => slug === 'base64');
if (!tool) throw new Error('缺少 Base64 工具注册信息');
---

<ToolLayout title={tool.title} description={tool.description} backgroundKey="tool-base64" statusId="base64-status">
  <div class="tool-segmented" role="group" aria-label="Base64 转换模式">
    <button type="button" data-base64-mode="encode" aria-pressed="true">编码</button>
    <button type="button" data-base64-mode="decode" aria-pressed="false">解码</button>
  </div>
  <div class="tool-fields">
    <div class="tool-field">
      <label for="base64-input">输入内容</label>
      <textarea id="base64-input" placeholder="输入文本或 Base64 内容" spellcheck="false"></textarea>
    </div>
    <div class="tool-field">
      <label for="base64-output">转换结果</label>
      <textarea id="base64-output" readonly placeholder="结果会显示在这里"></textarea>
    </div>
  </div>
  <div class="tool-toolbar" aria-label="Base64 操作">
    <button type="button" data-base64-action="swap">交换</button>
    <button type="button" data-base64-action="copy">复制结果</button>
    <button type="button" data-base64-action="clear">清空</button>
  </div>
</ToolLayout>

<script>
  import { decodeBase64, encodeBase64 } from '../../lib/tools/base64.ts';
  import { copyText, swapTransformation, type TransformationMode } from '../../lib/tools/browser.ts';

  const input = document.querySelector<HTMLTextAreaElement>('#base64-input');
  const output = document.querySelector<HTMLTextAreaElement>('#base64-output');
  const status = document.querySelector<HTMLElement>('#base64-status');
  let mode: TransformationMode = 'encode';

  const showStatus = (message: string, state: 'success' | 'error' | 'idle' = 'idle') => {
    if (!status) return;
    status.textContent = message;
    if (state === 'idle') delete status.dataset.state;
    else status.dataset.state = state;
  };

  const convert = () => {
    if (!input || !output) return;
    const result = mode === 'encode' ? encodeBase64(input.value) : decodeBase64(input.value);
    if (!result.ok) {
      output.value = '';
      showStatus(result.error, 'error');
      return;
    }
    output.value = result.value;
    showStatus(input.value === '' ? '等待输入内容' : '转换完成', input.value === '' ? 'idle' : 'success');
  };

  const setMode = (nextMode: TransformationMode) => {
    mode = nextMode;
    document.querySelectorAll<HTMLButtonElement>('[data-base64-mode]').forEach((control) => {
      control.setAttribute('aria-pressed', String(control.dataset.base64Mode === mode));
    });
  };

  document.querySelectorAll<HTMLButtonElement>('[data-base64-mode]').forEach((button) => {
    button.addEventListener('click', () => {
      setMode(button.dataset.base64Mode === 'decode' ? 'decode' : 'encode');
      convert();
    });
  });

  input?.addEventListener('input', convert);
  document.querySelectorAll<HTMLButtonElement>('[data-base64-action]').forEach((button) => {
    button.addEventListener('click', async () => {
      if (!input || !output) return;
      if (button.dataset.base64Action === 'swap') {
        const swapped = swapTransformation({ input: input.value, output: output.value, mode });
        input.value = swapped.input;
        output.value = swapped.output;
        setMode(swapped.mode);
        showStatus('已交换输入与输出，并切换转换方向', 'success');
        input.focus();
        return;
      }
      if (button.dataset.base64Action === 'clear') {
        input.value = '';
        output.value = '';
        showStatus('已清空内容');
        input.focus();
        return;
      }
      const result = await copyText(output.value);
      showStatus(result.ok ? '已复制转换结果' : result.error, result.ok ? 'success' : 'error');
    });
  });
</script>
