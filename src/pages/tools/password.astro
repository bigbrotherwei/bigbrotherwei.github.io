---
import { Copy, RotateCcw, Shuffle } from 'lucide-astro';
import ToolLayout from '../../components/tools/ToolLayout.astro';
import { tools } from '../../data/tools';

const tool = tools.find(({ slug }) => slug === 'password');
if (!tool) throw new Error('缺少随机密码工具注册信息');
---

<ToolLayout title={tool.title} description={tool.description} backgroundKey="tool-password" statusId="password-status" statusInside privacyNote="密码只在浏览器中生成，不会上传、保存或写入网址。">
  <div class="tool-field tool-field--compact">
    <label for="password-length">密码长度</label>
    <input id="password-length" type="number" min="8" max="64" step="1" value="16" inputmode="numeric" />
  </div>
  <fieldset class="password-groups">
    <legend>包含字符</legend>
    <label><input id="password-lower" type="checkbox" checked /> 小写字母</label>
    <label><input id="password-upper" type="checkbox" checked /> 大写字母</label>
    <label><input id="password-digits" type="checkbox" checked /> 数字</label>
    <label><input id="password-symbols" type="checkbox" /> 符号</label>
  </fieldset>
  <div class="tool-toolbar" aria-label="密码操作">
    <button type="button" data-password-action="generate" title="生成随机密码"><Shuffle size={18} aria-hidden="true" />生成密码</button>
    <button type="button" data-password-action="copy" title="复制密码" disabled><Copy size={18} aria-hidden="true" />复制密码</button>
    <button type="button" data-password-action="reset" title="重置选项并清空密码"><RotateCcw size={18} aria-hidden="true" />重置</button>
  </div>
  <div class="tool-field password-result">
    <label for="password-output">生成结果</label>
    <textarea id="password-output" readonly spellcheck="false" autocomplete="off" placeholder="生成的密码会显示在这里"></textarea>
  </div>
</ToolLayout>

<style>
  .password-groups { display: flex; flex-wrap: wrap; gap: 0.75rem 1.4rem; margin: 1rem 0 0; padding: 0; border: 0; color: var(--color-text); }
  .password-groups legend { margin-bottom: 0.5rem; color: var(--color-muted); font-size: 0.92rem; font-weight: 700; }
  .password-groups label { display: inline-flex; align-items: center; gap: 0.35rem; cursor: pointer; }
  .password-groups input { width: 1rem; height: 1rem; accent-color: var(--color-action); }
  .password-result { margin-top: 1rem; }
  .password-result textarea { min-height: 5.5rem; overflow-wrap: anywhere; resize: none; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .tool-toolbar button:disabled { cursor: not-allowed; opacity: 0.55; }
</style>

<script>
  import { copyText } from '../../lib/tools/browser.ts';
  import { generatePassword } from '../../lib/tools/password.ts';

  const lengthInput = document.querySelector<HTMLInputElement>('#password-length');
  const lower = document.querySelector<HTMLInputElement>('#password-lower');
  const upper = document.querySelector<HTMLInputElement>('#password-upper');
  const digits = document.querySelector<HTMLInputElement>('#password-digits');
  const symbols = document.querySelector<HTMLInputElement>('#password-symbols');
  const output = document.querySelector<HTMLTextAreaElement>('#password-output');
  const copyButton = document.querySelector<HTMLButtonElement>('[data-password-action="copy"]');
  const status = document.querySelector<HTMLElement>('#password-status');

  const showStatus = (message: string, state: 'success' | 'error' | 'idle' = 'idle') => {
    if (!status) return;
    status.textContent = message;
    if (state === 'idle') delete status.dataset.state;
    else status.dataset.state = state;
  };

  const clearResult = () => {
    if (output) output.value = '';
    if (copyButton) copyButton.disabled = true;
  };

  lengthInput?.addEventListener('input', () => { clearResult(); showStatus('设置已更改'); });
  for (const checkbox of [lower, upper, digits, symbols]) {
    checkbox?.addEventListener('change', () => { clearResult(); showStatus('设置已更改'); });
  }

  document.querySelector<HTMLButtonElement>('[data-password-action="generate"]')?.addEventListener('click', () => {
    if (!lengthInput || !lower || !upper || !digits || !symbols || !output) return;
    clearResult();
    if (!globalThis.crypto?.getRandomValues) {
      showStatus('此浏览器不支持安全随机数生成', 'error');
      return;
    }
    const result = generatePassword({
      length: Number(lengthInput.value),
      lower: lower.checked,
      upper: upper.checked,
      digits: digits.checked,
      symbols: symbols.checked,
    }, (count) => crypto.getRandomValues(new Uint8Array(count)));
    if (!result.ok) {
      showStatus(result.error, 'error');
      return;
    }
    output.value = result.value;
    if (copyButton) copyButton.disabled = false;
    showStatus(`已生成 ${result.value.length} 位密码`, 'success');
  });

  copyButton?.addEventListener('click', async () => {
    if (!output?.value) return;
    const result = await copyText(output.value);
    showStatus(result.ok ? '已复制密码' : result.error, result.ok ? 'success' : 'error');
  });

  document.querySelector<HTMLButtonElement>('[data-password-action="reset"]')?.addEventListener('click', () => {
    if (!lengthInput || !lower || !upper || !digits || !symbols) return;
    lengthInput.value = '16';
    lower.checked = true;
    upper.checked = true;
    digits.checked = true;
    symbols.checked = false;
    clearResult();
    showStatus('已重置设置并清空密码');
    lengthInput.focus();
  });
</script>
