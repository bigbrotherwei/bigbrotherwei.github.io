---
import ToolLayout from '../../components/tools/ToolLayout.astro';
import { tools } from '../../data/tools';

const tool = tools.find(({ slug }) => slug === 'text-counter');
if (!tool) throw new Error('缺少字数统计工具注册信息');
---

<ToolLayout title={tool.title} description={tool.description} backgroundKey="tool-text-counter" statusId="text-counter-status">
  <div class="tool-field">
    <label for="text-counter-input">文本内容</label>
    <textarea id="text-counter-input" placeholder="输入或粘贴文字后自动统计" spellcheck="false"></textarea>
  </div>
  <dl class="tool-results tool-statistics" aria-label="字数统计结果">
    <div><dt>字符</dt><dd><output id="count-characters">0</output></dd></div>
    <div><dt>去空白字符</dt><dd><output id="count-without-whitespace">0</output></dd></div>
    <div><dt>汉字</dt><dd><output id="count-chinese">0</output></dd></div>
    <div><dt>英文词</dt><dd><output id="count-english-words">0</output></dd></div>
    <div><dt>行数</dt><dd><output id="count-lines">0</output></dd></div>
    <div><dt>UTF-8 字节</dt><dd><output id="count-utf8-bytes">0</output></dd></div>
  </dl>
</ToolLayout>

<script>
  import { debounce } from '../../lib/tools/browser.ts';
  import { countText, shouldShowTextPerformanceNotice } from '../../lib/tools/text-counter.ts';

  const input = document.querySelector<HTMLTextAreaElement>('#text-counter-input');
  const status = document.querySelector<HTMLElement>('#text-counter-status');
  const outputs = {
    characters: document.querySelector<HTMLOutputElement>('#count-characters'),
    charactersWithoutWhitespace: document.querySelector<HTMLOutputElement>('#count-without-whitespace'),
    chineseCharacters: document.querySelector<HTMLOutputElement>('#count-chinese'),
    englishWords: document.querySelector<HTMLOutputElement>('#count-english-words'),
    lines: document.querySelector<HTMLOutputElement>('#count-lines'),
    utf8Bytes: document.querySelector<HTMLOutputElement>('#count-utf8-bytes'),
  };

  const update = () => {
    const statistics = countText(input?.value ?? '');
    Object.entries(outputs).forEach(([key, output]) => {
      if (output) output.textContent = String(statistics[key as keyof typeof statistics]);
    });
    if (status && shouldShowTextPerformanceNotice(statistics)) {
      status.textContent = '文本较大，统计已更新；继续输入时可能略有延迟。';
      delete status.dataset.state;
      status.dataset.performanceNotice = 'true';
    } else if (status?.dataset.performanceNotice) {
      status.textContent = '准备就绪';
      delete status.dataset.state;
      delete status.dataset.performanceNotice;
    }
  };

  const scheduleUpdate = debounce(update, 150);
  input?.addEventListener('input', scheduleUpdate);
</script>
