{
  "name": "blog-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "vars": {
    "ALLOWED_ORIGINS": "https://bigbrotherwei.github.io,http://localhost:4321"
  },
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-analytics",
      // Local tests use an isolated D1 database. Replace this UUID with the ID from `wrangler d1 create` before production deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
